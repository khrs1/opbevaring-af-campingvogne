---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Opbevaring af campingvogne, autocampere, både og veteranbiler i Ejstrupholm, Jylland." } = Astro.props;
---

<!doctype html>
<html lang="da">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | Opbevaring af Campingvogne</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={`https://opbevaring-af-campingvogne.dk${Astro.url.pathname}`} />
  <style is:global>
    *{box-sizing:border-box;margin:0;padding:0}
    :root{--navy:#14213d;--navy-l:#1d2c4f;--orange:#f4a424;--orange-d:#e08e14;--green:#5cb85c;--green-d:#3e9a3e;--bg:#f6f7f9;--surface:#fff;--text:#1c2230;--muted:#5d6572;--border:#e3e6ea}
    html{scroll-behavior:smooth}
    body{font-family:'Segoe UI',system-ui,-apple-system,Roboto,sans-serif;background:var(--bg);color:var(--text);line-height:1.65}
    a{color:inherit;text-decoration:none}
    img{max-width:100%;height:auto;display:block}
    .container{width:100%;max-width:1140px;margin:0 auto;padding:0 1.25rem}

    /* Top bar */
    .topbar{background:var(--navy);color:rgba(255,255,255,.85);font-size:.85rem;padding:.5rem 0}
    .topbar-inner{max-width:1140px;margin:0 auto;padding:0 1.25rem;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap}
    .topbar a{color:#fff;font-weight:600}
    .topbar a:hover{color:var(--orange)}

    /* Header */
    .site-header{background:var(--navy);position:sticky;top:0;z-index:100;box-shadow:0 2px 8px rgba(0,0,0,.2)}
    .header-inner{display:flex;align-items:center;justify-content:space-between;padding:.9rem 1.25rem;max-width:1140px;margin:0 auto;gap:1.5rem}
    .logo{display:flex;align-items:center;gap:.75rem;color:#fff}
    .logo img{width:52px;height:52px;object-fit:contain}
    .logo-text{font-size:1.05rem;font-weight:800;line-height:1.15}
    .logo-text span{display:block;font-size:.72rem;font-weight:500;color:var(--orange);letter-spacing:.03em}
    nav{display:flex;gap:1.75rem;align-items:center}
    nav a{color:rgba(255,255,255,.85);font-size:.92rem;font-weight:600;text-transform:uppercase;letter-spacing:.03em;transition:color .15s}
    nav a:hover{color:var(--orange)}
    .nav-cta{background:var(--orange);color:#fff!important;padding:.65rem 1.4rem;border-radius:30px;font-weight:700}
    .nav-cta:hover{background:var(--orange-d)}
    .nav-toggle{display:none;background:none;border:none;cursor:pointer;color:#fff;padding:.5rem}
    .mobile-menu{display:none;background:var(--navy-l);padding:1rem 1.25rem}
    .mobile-menu.open{display:block}
    .mobile-menu a{display:block;padding:.75rem 0;font-weight:600;color:#fff;border-bottom:1px solid rgba(255,255,255,.12)}
    @media(max-width:800px){nav{display:none}.nav-toggle{display:block}}

    /* Buttons */
    .btn{display:inline-block;background:var(--orange);color:#fff;padding:.85rem 1.75rem;border-radius:30px;font-weight:700;font-size:1rem;transition:background .15s,transform .15s;border:none;cursor:pointer;text-transform:uppercase;letter-spacing:.02em}
    .btn:hover{background:var(--orange-d);transform:translateY(-1px)}
    .btn-green{background:var(--green)}
    .btn-green:hover{background:var(--green-d)}
    .btn-outline{background:transparent;border:2px solid #fff;color:#fff}
    .btn-outline:hover{background:#fff;color:var(--navy)}

    /* Hero */
    .hero{position:relative;color:#fff;text-align:center;overflow:hidden;min-height:520px;display:flex;align-items:center;justify-content:center}
    .hero-bg{position:absolute;inset:0;background-size:cover;background-position:center}
    .hero-overlay{position:absolute;inset:0;background:linear-gradient(180deg,rgba(20,33,61,.55),rgba(20,33,61,.8))}
    .hero-inner{position:relative;padding:5rem 1.25rem;max-width:800px;margin:0 auto}
    .hero h1{font-size:clamp(2rem,5vw,3.1rem);font-weight:800;line-height:1.15;margin-bottom:1rem;text-shadow:0 2px 8px rgba(0,0,0,.3)}
    .hero p{font-size:clamp(1.05rem,2vw,1.25rem);color:rgba(255,255,255,.95);max-width:680px;margin:0 auto 2rem}
    .hero .btn{margin:0 .4rem .5rem}

    /* Sections */
    .section{padding:3.5rem 0}
    .section h2{font-size:clamp(1.5rem,3vw,2.1rem);font-weight:800;margin-bottom:.75rem}
    .section .lead{color:var(--muted);max-width:720px;margin-bottom:2rem}
    .center{text-align:center}
    .center .lead{margin-left:auto;margin-right:auto}
    .kicker{display:inline-block;color:var(--orange);font-weight:700;text-transform:uppercase;letter-spacing:.08em;font-size:.85rem;margin-bottom:.5rem}

    .features{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1.5rem;margin-top:2rem}
    .feature{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:1.75rem;text-align:center;box-shadow:0 2px 6px rgba(0,0,0,.05)}
    .feature .icon{width:60px;height:60px;border-radius:50%;background:rgba(244,164,36,.12);display:flex;align-items:center;justify-content:center;margin:0 auto .9rem;font-size:1.6rem}
    .feature .lbl{font-weight:700;margin-bottom:.4rem}
    .feature p{font-size:.88rem;color:var(--muted)}

    /* Cards with images */
    .cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:1.5rem;margin-top:2rem}
    .card{background:var(--surface);border:1px solid var(--border);border-radius:14px;overflow:hidden;box-shadow:0 2px 6px rgba(0,0,0,.06);display:flex;flex-direction:column}
    .card-img{aspect-ratio:16/10;overflow:hidden;background:#e8eaed}
    .card-img img{width:100%;height:100%;object-fit:cover;transition:transform .4s}
    .card:hover .card-img img{transform:scale(1.05)}
    .card-body{padding:1.5rem;flex:1;display:flex;flex-direction:column}
    .card-body h3{font-size:1.2rem;font-weight:800;margin-bottom:.6rem;color:var(--navy)}
    .card-body p{font-size:.92rem;margin-bottom:1rem;flex:1}

    /* Stats bar */
    .stats{background:var(--navy);color:#fff;padding:2.5rem 0}
    .stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:1.5rem;text-align:center}
    .stat .icon{font-size:2rem;margin-bottom:.5rem}
    .stat .big{font-size:1.5rem;font-weight:800;color:var(--orange)}
    .stat .small{color:rgba(255,255,255,.75);font-size:.9rem}

    /* Profile */
    .profile{background:var(--surface);border:1px solid var(--border);border-radius:14px;overflow:hidden;max-width:360px;margin:2rem auto 0;box-shadow:0 2px 8px rgba(0,0,0,.08)}
    .profile img{width:100%;aspect-ratio:1;object-fit:cover}
    .profile-body{padding:1.25rem;text-align:center}
    .profile-body strong{font-size:1.15rem;color:var(--navy)}
    .profile-body p{color:var(--muted);font-size:.9rem}

    /* CTA banner */
    .cta-banner{background:var(--navy);color:#fff;text-align:center;padding:3rem 0}
    .cta-banner h2{color:#fff;margin-bottom:.75rem}
    .cta-banner p{color:rgba(255,255,255,.85);max-width:520px;margin:0 auto 1.75rem}

    /* Contact form */
    .contact-box{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:2.5rem;max-width:640px;margin:0 auto}
    .contact-form{display:grid;gap:1rem;margin-top:1.5rem}
    .contact-form label{display:grid;gap:.4rem;font-weight:600;font-size:.95rem}
    .contact-form input,.contact-form select,.contact-form textarea{padding:.85rem 1rem;border:1px solid var(--border);border-radius:10px;font-size:1rem;font-family:inherit;background:var(--surface);color:var(--text)}
    .contact-form input:focus,.contact-form select:focus,.contact-form textarea:focus{outline:none;border-color:var(--orange)}

    /* Footer */
    .site-footer{background:var(--navy);color:rgba(255,255,255,.75);padding:3rem 0 1.5rem}
    .footer-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:2rem;margin-bottom:2rem}
    .footer-col h4{color:#fff;font-size:1rem;font-weight:700;margin-bottom:1rem}
    .footer-col p,.footer-col a{font-size:.9rem;color:rgba(255,255,255,.7);line-height:1.6}
    .footer-col a{display:block;margin-bottom:.5rem}
    .footer-col a:hover{color:var(--orange)}
    .footer-bottom{text-align:center;border-top:1px solid rgba(255,255,255,.12);padding-top:1.5rem;font-size:.8rem;color:rgba(255,255,255,.5)}

    /* Inner page hero (smaller) */
    .page-hero{background:var(--navy);color:#fff;padding:3rem 0;text-align:center}
    .page-hero h1{font-size:clamp(1.8rem,4vw,2.5rem);font-weight:800;margin-bottom:.75rem}
    .page-hero p{color:rgba(255,255,255,.85);max-width:640px;margin:0 auto}
  </style>
</head>
<body>
  <div class="topbar">
    <div class="topbar-inner">
      <span><a href="tel:+4527210795">📞 +45 27 21 07 95</a></span>
      <span><a href="mailto:opbevaringafcampingvogne@gmail.com">✉️ opbevaringafcampingvogne@gmail.com</a></span>
    </div>
  </div>

  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="logo">
        <img src="/img/logo.png" alt="Opbevaring af Campingvogne" />
        <span class="logo-text">Opbevaring af Campingvogne<span>Ejstrupholm, Jylland</span></span>
      </a>
      <nav aria-label="Hovednavigation">
        <a href="/">Forside</a>
        <a href="/om-os">Om os</a>
        <a href="/opbevaring">Opbevaring</a>
        <a href="/priser">Priser</a>
        <a href="/kontakt" class="nav-cta">Kontakt os</a>
      </nav>
      <button class="nav-toggle" onclick="document.getElementById('mm').classList.toggle('open')" aria-label="Menu" aria-expanded="false">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
    <div class="mobile-menu" id="mm">
      <a href="/">Forside</a>
      <a href="/om-os">Om os</a>
      <a href="/opbevaring">Opbevaring</a>
      <a href="/priser">Priser</a>
      <a href="/kontakt">Kontakt os</a>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col">
          <h4>Opbevaring af Campingvogne</h4>
          <p>Vi er din go-to, når det kommer til opbevaring af campingvogne i Jylland. Sikker og tør opbevaring i Ejstrupholm.</p>
        </div>
        <div class="footer-col">
          <h4>Navigation</h4>
          <a href="/">Forside</a>
          <a href="/om-os">Om os</a>
          <a href="/opbevaring">Opbevaring</a>
          <a href="/priser">Priser</a>
          <a href="/kontakt">Kontakt</a>
        </div>
        <div class="footer-col">
          <h4>Kontakt</h4>
          <p>Trindhøjvej 5<br/>7361 Ejstrupholm</p>
          <a href="mailto:opbevaringafcampingvogne@gmail.com">opbevaringafcampingvogne@gmail.com</a>
          <a href="tel:+4527210795">+45 27 21 07 95</a>
          <p>Telefontid 9:00 til 20:00</p>
        </div>
      </div>
      <div class="footer-bottom">© {new Date().getFullYear()} opbevaring-af-campingvogne.dk</div>
    </div>
  </footer>
</body>
</html>
