---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<Layout title="Opbevaring af autocampere i Jylland">
  <section class="page-hero">
    <div class="container">
      <span class="kicker" style="color:var(--orange)">Autocampere</span>
      <h1>Opbevaring af autocampere</h1>
      <p>Tryg og tør opbevaring af din autocamper i Ejstrupholm, Jylland.</p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:820px">
      <h2>Din autocamper står trygt i off-sæsonen</h2>
      <p class="lead">Vi opbevarer din autocamper trygt i vores bygning, så du ved, at din vogn står i ly i off-sæsonen. Din autocamper holder sig tør og beskyttet mod vejrets luner.</p>

      <div class="features" style="margin-top:2rem">
        <div class="feature"><div class="icon">🏠</div><div class="lbl">Indendørs opbevaring</div><p>Din autocamper står i ly i vores hal.</p></div>
        <div class="feature"><div class="icon">🔒</div><div class="lbl">Aflåst område</div><p>Din autocamper står i et aflåst og beskyttet område.</p></div>
        <div class="feature"><div class="icon">🌡️</div><div class="lbl">Tør og sikker</div><p>Beskyttet mod frost og vejr.</p></div>
        <div class="feature"><div class="icon">💧</div><div class="lbl">Vinterklargøring</div><p>Kan mod betaling hjælpe med rens, vask og tømning af vand.</p></div>
      </div>

      <h2 style="margin-top:2.5rem">Vinteropbevaring af autocamper</h2>
      <p style="margin-bottom:1rem">Vi tilbyder vinteropbevaring af din autocamper. Mod betaling hjælper vi gerne med klargøring:</p>
      <ul style="margin:0 0 2rem 1.5rem;display:grid;gap:.5rem">
        <li>Rens og vask af autocamperen</li>
        <li>Tømning af vand og vinterkonservering</li>
      </ul>

      <div style="background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:1.75rem;margin:2rem 0">
        <h3 style="color:var(--navy);margin-bottom:.5rem">Hvad koster opbevaring af autocamper?</h3>
        <p style="margin-bottom:1rem">Prisen afhænger af din autocampers størrelse og opbevaringsperiode. Vi afgiver gerne et uforpligtende tilbud.</p>
        <ContactForm defaultKoeretoej="Autocamper" />
      </div>
    </div>
  </section>

  <!-- Related services -->
  <section class="section" style="background:var(--surface);border-top:1px solid var(--border)">
    <div class="container">
      <div class="center">
        <span class="kicker">Opbevaringstyper</span>
        <h2>Andre opbevaringsmuligheder</h2>
      </div>
      <div class="cards">
        <div class="card"><div class="card-body"><h3>Campingvogne</h3><p>Den opgave vi oftest får.</p><a href="/opbevaring" style="color:var(--orange);font-weight:700">Se mere →</a></div></div>
        <div class="card"><div class="card-body"><h3>Både</h3><p>Opbevaring af både på trailer.</p><a href="/opbevaring/baadopbevaring" style="color:var(--orange);font-weight:700">Se mere →</a></div></div>
        <div class="card"><div class="card-body"><h3>Veteranbiler</h3><p>Opbevaring af veteranbiler.</p><a href="/opbevaring/veteranbiler" style="color:var(--orange);font-weight:700">Se mere →</a></div></div>
        <div class="card"><div class="card-body"><h3>Motorcykler</h3><p>Tryg opbevaring af motorcykler.</p><a href="/opbevaring/motorcykler" style="color:var(--orange);font-weight:700">Se mere →</a></div></div>
      </div>
    </div>
  </section>

  <section class="cta-banner">
    <div class="container">
      <h2>Opbevar din autocamper hos os</h2>
      <p>Kontakt os i dag og få et uforpligtende tilbud.</p>
      <a href="/kontakt" class="btn">Kontakt os</a>
    </div>
  </section>
</Layout>
