---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<Layout title="Opbevaring af motorcykler i Jylland">
  <section class="page-hero">
    <div class="container">
      <span class="kicker" style="color:var(--orange)">Motorcykler</span>
      <h1>Opbevaring af motorcykler</h1>
      <p>Sikker og tør opbevaring af din motorcykel i Ejstrupholm, Jylland.</p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:820px">
      <h2>Opbevar din motorcykel trygt</h2>
      <p class="lead">Vi opbevarer gerne motorcykler i vores hal. Bemærk, at der ikke er varme på året rundt – men vores velventilerede hal beskytter din motorcykel mod vejrets luner.</p>

      <div class="features" style="margin-top:2rem">
        <div class="feature"><div class="icon">🏠</div><div class="lbl">Indendørs opbevaring</div><p>Din motorcykel står i ly i vores hal.</p></div>
        <div class="feature"><div class="icon">🔒</div><div class="lbl">Aflåst område</div><p>Din motorcykel står i et aflåst og beskyttet område.</p></div>
        <div class="feature"><div class="icon">💨</div><div class="lbl">Ventileret hal</div><p>God luftcirkulation.</p></div>
        <div class="feature"><div class="icon">💰</div><div class="lbl">Jyske priser</div><p>Rimelig opbevaring af din motorcykel.</p></div>
      </div>

      <div style="background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:1.75rem;margin:2rem 0">
        <h3 style="color:var(--navy);margin-bottom:.5rem">Vigtigt at vide</h3>
        <p style="margin-bottom:1rem">Der er ikke varme i hallen året rundt. Kontakt os gerne for at høre mere om vores faciliteter.</p>
        <ContactForm defaultKoeretoej="Mindre køretøj (MC, ATV)" />
      </div>
    </div>
  </section>

  <!-- Related services -->
  <section class="section" style="background:var(--surface);border-top:1px solid var(--border)">
    <div class="container">
      <div class="center">
        <span class="kicker">Opbevaringstyper</span>
        <h2>Andre opbevaringsmuligheder</h2>
      </div>
      <div class="cards">
        <div class="card"><div class="card-body"><h3>Campingvogne</h3><p>Den opgave vi oftest får.</p><a href="/opbevaring" style="color:var(--orange);font-weight:700">Se mere →</a></div></div>
        <div class="card"><div class="card-body"><h3>Både</h3><p>Opbevaring af både på trailer.</p><a href="/opbevaring/baadopbevaring" style="color:var(--orange);font-weight:700">Se mere →</a></div></div>
        <div class="card"><div class="card-body"><h3>Autocampere</h3><p>Din autocamper står trygt i off-sæsonen.</p><a href="/opbevaring/autocampere" style="color:var(--orange);font-weight:700">Se mere →</a></div></div>
        <div class="card"><div class="card-body"><h3>Veteranbiler</h3><p>Opbevaring af veteranbiler.</p><a href="/opbevaring/veteranbiler" style="color:var(--orange);font-weight:700">Se mere →</a></div></div>
      </div>
    </div>
  </section>

  <section class="cta-banner">
    <div class="container">
      <h2>Opbevar din motorcykel hos os</h2>
      <p>Kontakt os i dag og få et uforpligtende tilbud.</p>
      <a href="/kontakt" class="btn">Kontakt os</a>
    </div>
  </section>
</Layout>
