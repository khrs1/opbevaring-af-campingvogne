---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<Layout title="Opbevaring af både og bådtrailere i Jylland">
  <section class="page-hero">
    <div class="container">
      <span class="kicker" style="color:var(--orange)">Bådopbevaring</span>
      <h1>Opbevaring af både og bådtrailere</h1>
      <p>Sikker og tør opbevaring af din båd på trailer hele året rundt i Ejstrupholm, Jylland.</p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:820px">
      <h2>Opbevar din båd sikkert på trailer</h2>
      <p class="lead">Vi har erfaring med opbevaring af både på trailere. Din båd står trygt og tørt i vores ventileret hal, beskyttet mod vejrets luner hele året.</p>

      <div class="features" style="margin-top:2rem">
        <div class="feature"><div class="icon">🏠</div><div class="lbl">Indendørs opbevaring</div><p>Din båd står på trailer i ly i vores hal.</p></div>
        <div class="feature"><div class="icon">🔒</div><div class="lbl">Aflåst område</div><p>Din båd står i et aflåst og beskyttet område.</p></div>
        <div class="feature"><div class="icon">🌡️</div><div class="lbl">Frostsikret</div><p>Velventileret hal, der minimerer frostskader.</p></div>
        <div class="feature"><div class="icon">💧</div><div class="lbl">Vinterklargøring</div><p>Kan mod betaling hjælpe med rens, vask og tømning af vand.</p></div>
      </div>

      <h2 style="margin-top:2.5rem">Vinterklargøring af din båd</h2>
      <p style="margin-bottom:1rem">Mod betaling hjælper vi gerne med klargøring af din båd til vinteropbevaring. Det inkluderer typisk:</p>
      <ul style="margin:0 0 2rem 1.5rem;display:grid;gap:.5rem">
        <li>Rens og vask af båden</li>
        <li>Tømning af vand og vinterkonservering</li>
        <li>Kontrol af motor og vigtige komponenter</li>
      </ul>

      <div style="background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:1.75rem;margin:2rem 0">
        <h3 style="color:var(--navy);margin-bottom:.5rem">Hvad koster bådopbevaring?</h3>
        <p style="margin-bottom:1rem">Prisen afhænger af din båds størrelse og opbevaringsperiode. Vi afgiver gerne et uforpligtende tilbud.</p>
        <ContactForm defaultKoeretoej="Bådtrailer m. båd" />
      </div>
    </div>
  </section>

  <!-- Related services -->
  <section class="section" style="background:var(--surface);border-top:1px solid var(--border)">
    <div class="container">
      <div class="center">
        <span class="kicker">Opbevaringstyper</span>
        <h2>Andre opbevaringsmuligheder</h2>
      </div>
      <div class="cards">
        <div class="card"><div class="card-body"><h3>Campingvogne</h3><p>Den opgave vi oftest får.</p><a href="/opbevaring" style="color:var(--orange);font-weight:700">Se mere →</a></div></div>
        <div class="card"><div class="card-body"><h3>Autocampere</h3><p>Din autocamper står trygt i off-sæsonen.</p><a href="/opbevaring/autocampere" style="color:var(--orange);font-weight:700">Se mere →</a></div></div>
        <div class="card"><div class="card-body"><h3>Veteranbiler</h3><p>Opbevaring af veteranbiler.</p><a href="/opbevaring/veteranbiler" style="color:var(--orange);font-weight:700">Se mere →</a></div></div>
        <div class="card"><div class="card-body"><h3>Motorcykler</h3><p>Tryg opbevaring af motorcykler.</p><a href="/opbevaring/motorcykler" style="color:var(--orange);font-weight:700">Se mere →</a></div></div>
      </div>
    </div>
  </section>

  <section class="cta-banner">
    <div class="container">
      <h2>Sikre plads til din båd</h2>
      <p>Kontakt os i dag og få et uforpligtende tilbud på opbevaring af din båd.</p>
      <a href="/kontakt" class="btn">Kontakt os</a>
    </div>
  </section>
</Layout>
