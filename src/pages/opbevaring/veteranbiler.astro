---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Opbevaring af veteranbiler i Jylland">
  <section class="page-hero">
    <div class="container">
      <span class="kicker" style="color:var(--orange)">Veteranbiler</span>
      <h1>Opbevaring af veteranbiler</h1>
      <p>Sikker og tør opbevaring af din veteranbil i Ejstrupholm, Jylland.</p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:820px">
      <h2>Opbevar din veteranbil trygt</h2>
      <p class="lead">Vi opbevarer gerne veteranbiler i vores hal. Bemærk, at der ikke er varme på året rundt – men vores velventilerede hal beskytter din bil mod vejrets luner.</p>

      <div class="features" style="margin-top:2rem">
        <div class="feature"><div class="icon">🏠</div><div class="lbl">Indendørs opbevaring</div><p>Din veteranbil står i ly i vores hal.</p></div>
        <div class="feature"><div class="icon">📹</div><div class="lbl">Videoovervågning 24/7</div><p>Døgnet rundt beskyttelse.</p></div>
        <div class="feature"><div class="icon">💨</div><div class="lbl">Ventileret hal</div><p>God luftcirkulation for din bil.</p></div>
      </div>

      <div style="background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:1.75rem;margin:2rem 0">
        <h3 style="color:var(--navy);margin-bottom:.5rem">Vigtigt at vide</h3>
        <p style="margin-bottom:1rem">Der er ikke varme i hallen året rundt. Kontakt os gerne for at høre mere om vores faciliteter, så du ved, om det passer til din veteranbil.</p>
        <a href="/kontakt" class="btn">Kontakt os</a>
      </div>
    </div>
  </section>

  <!-- Related services -->
  <section class="section" style="background:var(--surface);border-top:1px solid var(--border)">
    <div class="container">
      <div class="center">
        <span class="kicker">Opbevaringstyper</span>
        <h2>Andre opbevaringsmuligheder</h2>
      </div>
      <div class="cards">
        <div class="card"><div class="card-body"><h3>Campingvogne</h3><p>Den opgave vi oftest får.</p><a href="/opbevaring" style="color:var(--orange);font-weight:700">Se mere →</a></div></div>
        <div class="card"><div class="card-body"><h3>Både</h3><p>Opbevaring af både på trailer.</p><a href="/opbevaring/baadopbevaring" style="color:var(--orange);font-weight:700">Se mere →</a></div></div>
        <div class="card"><div class="card-body"><h3>Autocampere</h3><p>Din autocamper står trygt i off-sæsonen.</p><a href="/opbevaring/autocampere" style="color:var(--orange);font-weight:700">Se mere →</a></div></div>
        <div class="card"><div class="card-body"><h3>Motorcykler</h3><p>Tryg opbevaring af motorcykler.</p><a href="/opbevaring/motorcykler" style="color:var(--orange);font-weight:700">Se mere →</a></div></div>
      </div>
    </div>
  </section>

  <section class="cta-banner">
    <div class="container">
      <h2>Opbevar din veteranbil hos os</h2>
      <p>Kontakt os i dag og få et uforpligtende tilbud.</p>
      <a href="/kontakt" class="btn">Kontakt os</a>
    </div>
  </section>
</Layout>
