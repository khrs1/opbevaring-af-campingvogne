---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Kontakt os">
  <section class="page-hero">
    <div class="container">
      <h1>Kontakt os</h1>
      <p>Har du spørgsmål om opbevaring? Få fat i os på telefon eller via formularen herunder.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="center" style="margin-bottom:2rem">
        <span class="kicker">Kontakt</span>
        <h2>Få fat i os</h2>
        <p class="lead" style="margin-left:auto;margin-right:auto">Adresse: Trindhøjvej 5, 7361 Ejstrupholm · Telefontid 9:00 til 20:00</p>
      </div>

      <div class="contact-box">
        <p style="text-align:center;margin-bottom:1.5rem">
          <a href="tel:+4527210795" style="color:var(--orange);font-weight:700">📞 Ring til Jens: +45 27 21 07 95</a><br/>
          <a href="mailto:opbevaringafcampingvogne@gmail.com" style="color:var(--orange);font-weight:700">✉️ opbevaringafcampingvogne@gmail.com</a>
        </p>

        <h3 style="text-align:center;margin-bottom:.5rem">Send os en besked</h3>
        <form class="contact-form" method="post" action="https://formsubmit.co/opbevaringafcampingvogne@gmail.com">
          <input type="hidden" name="_subject" value="Ny forespørgsel fra opbevaring-af-campingvogne.dk" />
          <input type="hidden" name="_next" value="https://opbevaring-af-campingvogne.dk/tak" />
          <input type="text" name="_honey" style="display:none" />
          <label>
            Navn
            <input type="text" name="navn" required placeholder="Dit navn" />
          </label>
          <label>
            Email
            <input type="email" name="email" required placeholder="Din email" />
          </label>
          <label>
            Telefon
            <input type="tel" name="telefon" placeholder="Dit telefonnummer" />
          </label>
          <label>
            Hvad ønsker du opbevaret?
            <select name="koeretoej">
              <option value="Campingvogn">Campingvogn</option>
              <option value="Autocamper">Autocamper</option>
              <option value="Bådtrailer m. båd">Bådtrailer m. båd</option>
              <option value="Bil">Bil</option>
              <option value="Mindre køretøj (MC, ATV)">Mindre køretøj (MC, ATV)</option>
            </select>
          </label>
          <label>
            Besked
            <textarea name="besked" rows="5" placeholder="Skriv din besked her..."></textarea>
          </label>
          <button type="submit" class="btn" style="width:100%">Send besked</button>
        </form>
      </div>
    </div>
  </section>
</Layout>
