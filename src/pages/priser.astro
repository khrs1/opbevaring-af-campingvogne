---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Priser">
  <section class="page-hero">
    <div class="container">
      <h1>Priser på opbevaring</h1>
      <p>Jyske priser på sikker og tør opbevaring af campingvogne, autocampere, både og veteranbiler.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="center">
        <span class="kicker">Opbevaringspriser</span>
        <h2>Fleksible priser efter behov</h2>
        <p class="lead">Vi tilbyder vinteropbevaring og halv- til helårs opbevaring. Priserne afhænger af dit køretøjs størrelse og opbevaringsperiode.</p>
      </div>

      <div class="cards" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr))">
        <div class="card">
          <div class="card-body" style="text-align:center">
            <h3 style="font-size:1.35rem">Vinteropbevaring</h3>
            <p>Opbevaring over vintersæsonen i vores ventileret hal.</p>
            <p style="font-weight:800;color:var(--orange);font-size:1.1rem;margin-top:auto">Kontakt os for pris</p>
          </div>
        </div>
        <div class="card">
          <div class="card-body" style="text-align:center">
            <h3 style="font-size:1.35rem">Helårsopbevaring</h3>
            <p>Tryg opbevaring hele året rundt, så din vogn står klar når du skal bruge den.</p>
            <p style="font-weight:800;color:var(--orange);font-size:1.1rem;margin-top:auto">Kontakt os for pris</p>
          </div>
        </div>
        <div class="card">
          <div class="card-body" style="text-align:center">
            <h3 style="font-size:1.35rem">Klargøring</h3>
            <p>Mod betaling hjælper vi med klargøring – rens og vask, tømning af vand mm.</p>
            <p style="font-weight:800;color:var(--orange);font-size:1.1rem;margin-top:auto">Kontakt os for pris</p>
          </div>
        </div>
      </div>

      <div style="text-align:center;margin-top:2.5rem">
        <p style="color:var(--muted);margin-bottom:1.25rem">Priserne varierer efter køretøjets størrelse og periode. Ring og få et uforpligtende tilbud.</p>
        <a href="tel:+4527210795" class="btn">Ring til Jens: +45 27 21 07 95</a>
      </div>
    </div>
  </section>
</Layout>
